# A.I.R. VaultNode — Environment Configuration
# Blackglass Continuum LLC // CAGE: 17TJ5
# Copy to .env and fill in real values before launch.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
AIR_DB_USER=architect
AIR_DB_PASSWORD=your_sovereign_password_here
AIR_DB_NAME=air_node
AIR_DB_HOST=localhost
AIR_DB_PORT=5432

# ---------------------------------------------------------------------------
# Auth Boundary (NIST 800-53 IA-2 / SC-8)
# ---------------------------------------------------------------------------
# Shared secret between VaultNode and Variance Core's air_node.py adapter.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Set the SAME value in BOTH repos:
#   - air-node/.env                      (enforced server-side on GET /incidents)
#   - blackglass-variance-core/.env      (sent as X-API-Key header by adapter)
AIR_NODE_API_KEY=

# Set to "true" to hard-fail adapter startup if AIR_NODE_API_KEY is absent.
# Keep "false" for local dev; MUST be "true" before Sentinel integration.
AIR_REQUIRE_AUTH=false
